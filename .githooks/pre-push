#!/bin/bash
# Pre-Push Hook: Protect 'main' branch
# 1. Blocks accidental deletion of 'main'
# 2. Blocks force-pushes (--force / --force-with-lease) to 'main'

z40="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha
do
    # Check if target branch is main
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        # 1. Prevent branch deletion
        if [ "$local_sha" = $z40 ]; then
            echo "❌ [BRANCH PROTECTION] Deleting 'main' branch is strictly forbidden!"
            exit 1
        fi

        # 2. Prevent force-push (non-fast-forward updates)
        if [ "$remote_sha" != $z40 ]; then
            git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null
            if [ $? -ne 0 ]; then
                echo "❌ [BRANCH PROTECTION] Force-push to 'main' is strictly blocked!"
                echo "   Use feature branches and pull requests to merge into main."
                exit 1
            fi
        fi

        echo "🛡️  [BRANCH PROTECTION] Fast-forward check passed for 'main'."
    fi
done

exit 0
