# ==============================================================================
# Universal Omnichannel AI Voice & Chat Receptionist Blueprint
# Production & Local Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and provide your API keys to activate external providers.
# The system operates with resilient local simulations out-of-the-box.

# ------------------------------------------------------------------------------
# 1. DATABASE: NEON POSTGRESQL (Production) / SQLITE (Local Fallback)
# ------------------------------------------------------------------------------
# Provide your Neon connection string in production. Supports postgresql:// and postgres://
# DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SALON_DB_PATH=salon_bookings.db
SALON_EXCEL_PATH=salon_appointments.xlsx

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEFAULT_TENANT_ID=salon
DEFAULT_ACCENT=red_american
USE_RAG=false

# ------------------------------------------------------------------------------
# 3. TELEPHONY & VOICE (Vapi)
# ------------------------------------------------------------------------------
# Get from: https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER=+16673070119

# ------------------------------------------------------------------------------
# 4. WHATSAPP & SMS AUTOMATION (Twilio)
# ------------------------------------------------------------------------------
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886

# ------------------------------------------------------------------------------
# 5. LLM REASONING & EMBEDDINGS (OpenAI)
# ------------------------------------------------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VOICE=nova

# ------------------------------------------------------------------------------
# 6. FEMALE VOICE & ACCENT SYNTHESIS (ElevenLabs)
# ------------------------------------------------------------------------------
# Get from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_RED_AMERICAN=21m00Tcm4TlvDq8ikWAM      # Rachel / Sofia (Southern / US)
ELEVENLABS_VOICE_INDIAN_ENGLISH=ThT5KcBeYPX3keUQqHPh    # Dorothy / Priya (Indian English)
ELEVENLABS_VOICE_AFRICAN_ENGLISH=EXAVITQu4vr4xnSDxMaL   # Bella / Amina (African English)
ELEVENLABS_VOICE_EUROPEAN_BRITISH=pFZP5JQG7iQjIQuC4Bku  # Lily (British English RP)

# ------------------------------------------------------------------------------
# 7. WEBRTC DIRECT BROWSER AUDIO STREAMING (LiveKit)
# ------------------------------------------------------------------------------
# Get from: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 8. GOOGLE CALENDAR & SHEETS TWO-WAY INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 9. META OMNICHANNEL (WhatsApp Cloud API, Facebook Messenger & Instagram Direct)
# ------------------------------------------------------------------------------
# Get from: https://developers.facebook.com
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_VERIFY_TOKEN=omnichannel_secure_token_123
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
META_PAGE_ID=your_facebook_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# ------------------------------------------------------------------------------
# 10. TELEGRAM BOT (BotFather)
# ------------------------------------------------------------------------------
# Get token by messaging @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 11. TWITTER / X DEVELOPER PORTAL (Direct Messages & Account Activity API)
# ------------------------------------------------------------------------------
# Get from: https://developer.x.com
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ------------------------------------------------------------------------------
# 12. LINKEDIN MESSAGING (Developer Portal)
# ------------------------------------------------------------------------------
# Get from: https://developer.linkedin.com
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# ------------------------------------------------------------------------------
# 13. TIKTOK BUSINESS MESSAGING (TikTok for Developers)
# ------------------------------------------------------------------------------
# Get from: https://business-api.tiktok.com/portal
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# ------------------------------------------------------------------------------
# 14. META THREADS API (Threads for Developers)
# ------------------------------------------------------------------------------
# Get from: https://developers.facebook.com (Threads App Use Case)
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_VERIFY_TOKEN=omnichannel_threads_token_123

# ------------------------------------------------------------------------------
# 15. REDDIT DEVELOPER API (Script & Bot Application)
# ------------------------------------------------------------------------------
# Get from: https://www.reddit.com/prefs/apps (Create 'script' type app)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_account_password_here
REDDIT_USER_AGENT=OmniReceptionistBot/1.0.0 by /u/your_reddit_username_here

