# ==============================================================================
# Universal Omnichannel AI Voice & Chat Receptionist Blueprint
# Multi-Tenant Production Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL / Local SQLite)
# ------------------------------------------------------------------------------
# Production: Set your pooled Neon Cloud PostgreSQL connection string:
NEON_POSTGRES_CONNECTION_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Local SQLite fallback:
SALON_DB_PATH=salon_bookings.db
SALON_EXCEL_PATH=salon_appointments.xlsx

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & MULTI-TENANCY SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEFAULT_TENANT_ID=salon
DEFAULT_ACCENT=general_american
USE_RAG=true
APP_BASE_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 3. VOICE ORCHESTRATION & TELEPHONY (Vapi)
# ------------------------------------------------------------------------------
# Obtain from https://dashboard.vapi.ai
VAPI_PRIVATE_API_KEY=your_vapi_private_api_key_here
VAPI_PUBLIC_API_KEY=your_vapi_public_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER=+16673070119
VAPI_SERVER_URL=https://your-domain.com/webhook/vapi-tools

# ------------------------------------------------------------------------------
# 4. SMS & CALL AUTOMATION (Twilio)
# ------------------------------------------------------------------------------
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+19124999633
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VOICE_WEBHOOK_URL=https://your-domain.com/webhook/twilio-voice

# ------------------------------------------------------------------------------
# 5. LLM REASONING & EMBEDDINGS (OpenAI)
# ------------------------------------------------------------------------------
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VOICE=nova

# ------------------------------------------------------------------------------
# 6. VOICE SYNTHESIS (ElevenLabs - Optional Fallback)
# ------------------------------------------------------------------------------
# Obtain from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_RED_AMERICAN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_INDIAN_ENGLISH=ThT5KcBeYPX3keUQqHPh
ELEVENLABS_VOICE_AFRICAN_ENGLISH=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_EUROPEAN_BRITISH=pFZP5JQG7iQjIQuC4Bku

# ------------------------------------------------------------------------------
# 7. WEBRTC DIRECT BROWSER AUDIO (LiveKit - Optional)
# ------------------------------------------------------------------------------
# Obtain from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 8. CALENDAR & SPREADSHEETS (Google Calendar & Google Sheets)
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
# Or provide inline single-line JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# ------------------------------------------------------------------------------
# 9. META PLATFORM INTEGRATIONS (WhatsApp, Messenger, Instagram, Threads)
# ------------------------------------------------------------------------------
# Obtain from https://developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_WEBHOOK_VERIFY_TOKEN=your_secure_verify_token_here
META_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/facebook/callback

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp

# Facebook Messenger & Instagram Direct
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
MESSENGER_WEBHOOK_URL=https://your-domain.com/webhook/messenger
INSTAGRAM_WEBHOOK_URL=https://your-domain.com/webhook/instagram

# Meta Threads API
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_VERIFY_TOKEN=your_threads_verify_token_here
THREADS_WEBHOOK_URL=https://your-domain.com/webhook/threads

# ------------------------------------------------------------------------------
# 10. SOCIAL MESSAGING CHANNELS (Telegram, X/Twitter, LinkedIn, TikTok, Reddit)
# ------------------------------------------------------------------------------
# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# Twitter / X Developer Portal
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_WEBHOOK_URL=https://your-domain.com/webhook/twitter

# LinkedIn Developer Portal
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_WEBHOOK_URL=https://your-domain.com/webhook/linkedin
LINKEDIN_REDIRECT_URI=https://your-domain.com/api/oauth/linkedin/callback

# TikTok Business Messaging
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_WEBHOOK_URL=https://your-domain.com/webhook/tiktok

# Reddit Bot Application
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_USER_AGENT=OmniReceptionistBot/1.0.0 by /u/your_reddit_username
REDDIT_WEBHOOK_URL=https://your-domain.com/webhook/reddit

# ------------------------------------------------------------------------------
# 11. VECTOR MEMORY & OBSERVABILITY (Qdrant & Langfuse)
# ------------------------------------------------------------------------------
# Qdrant Cloud (Hybrid Vector Search)
QDRANT_URL=https://your-cluster-id.us-central1-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Langfuse (LLM Tracing & Observability)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_key
CLERK_SECRET_KEY=sk_test_key

TELNYX_API_KEY=KEY_12345