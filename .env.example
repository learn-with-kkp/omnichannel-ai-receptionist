# ==============================================================================
# Universal Omnichannel AI Voice & Chat Receptionist Blueprint
# Multi-Tenant Production Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE: NEON POSTGRESQL (Production) / SQLITE (Local Fallback)
# ------------------------------------------------------------------------------
# In production, set your pooled Neon Cloud PostgreSQL connection string:
NEON_POSTGRES_CONNECTION_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Local SQLite fallback:
SALON_DB_PATH=salon_bookings.db
SALON_EXCEL_PATH=salon_appointments.xlsx

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEFAULT_TENANT_ID=salon
DEFAULT_ACCENT=red_american
USE_RAG=true
APP_BASE_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 3. TELEPHONY & VOICE (Vapi)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.vapi.ai
VAPI_PUBLIC_API_KEY=your_vapi_public_api_key_here
VAPI_PRIVATE_API_KEY=your_vapi_private_api_key_here
VAPI_PUBLIC_KEY=your_vapi_public_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_PHONE_NUMBER=+16172718180

# Assistants & Squads:
VAPI_ASSISTANT_ID=your_vapi_default_assistant_id_here
VAPI_SOPHIA_ASSISTANT_ID=your_vapi_sophia_assistant_id_here
VAPI_MARCUS_ASSISTANT_ID=your_vapi_marcus_assistant_id_here
VAPI_KISHOR_ASSISTANT_ID=your_vapi_kishor_assistant_id_here
VAPI_TASNIM_ASSISTANT_ID=your_vapi_tasnim_assistant_id_here
VAPI_RAIYAN_ASSISTANT_ID=your_vapi_raiyan_assistant_id_here
VAPI_SQUAD_ID=your_vapi_squad_id_here
VAPI_CAMPAIGN_ID=

# Vapi Server Tools Webhook & Tool IDs:
VAPI_SERVER_URL=https://your-domain.com/webhook/vapi-tools
VAPI_TOOL_CHECK_AVAILABILITY=your_vapi_tool_check_availability_id
VAPI_TOOL_BOOK_APPOINTMENT=your_vapi_tool_book_appointment_id
VAPI_TOOL_LOOKUP_APPOINTMENT=your_vapi_tool_lookup_appointment_id
VAPI_TOOL_RESCHEDULE_APPOINTMENT=your_vapi_tool_reschedule_appointment_id
VAPI_TOOL_CANCEL_APPOINTMENT=your_vapi_tool_cancel_appointment_id
VAPI_TOOL_SEND_TEXT=your_vapi_tool_send_text_id
VAPI_TOOL_KNOWLEDGE=your_vapi_tool_knowledge_id
VAPI_TOOL_END_CALL=your_vapi_tool_end_call_id
VAPI_TOOL_TRANSFER_MARCUS=your_vapi_tool_transfer_marcus_id
VAPI_TOOL_TRANSFER_SOPHIA=your_vapi_tool_transfer_sophia_id

# ------------------------------------------------------------------------------
# 4. WHATSAPP & SMS AUTOMATION (Twilio)
# ------------------------------------------------------------------------------
# Obtain from: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+19124999633
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VOICE_WEBHOOK_URL=https://your-domain.com/webhook/twilio-voice

# ------------------------------------------------------------------------------
# 5. LLM REASONING & EMBEDDINGS (OpenAI)
# ------------------------------------------------------------------------------
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VOICE=nova

# ------------------------------------------------------------------------------
# 6. FEMALE VOICE & ACCENT SYNTHESIS (ElevenLabs)
# ------------------------------------------------------------------------------
# Obtain from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_RED_AMERICAN=21m00Tcm4TlvDq8ikWAM      # Rachel / Sofia (Southern / US)
ELEVENLABS_VOICE_INDIAN_ENGLISH=ThT5KcBeYPX3keUQqHPh    # Dorothy / Priya (Indian English)
ELEVENLABS_VOICE_AFRICAN_ENGLISH=EXAVITQu4vr4xnSDxMaL   # Bella / Amina (African English)
ELEVENLABS_VOICE_EUROPEAN_BRITISH=pFZP5JQG7iQjIQuC4Bku  # Lily (British English RP)

# ------------------------------------------------------------------------------
# 7. WEBRTC DIRECT BROWSER AUDIO STREAMING (LiveKit)
# ------------------------------------------------------------------------------
# Obtain from: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 8. GOOGLE CALENDAR & SHEETS TWO-WAY INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "..."}'

# ------------------------------------------------------------------------------
# 9. META OMNICHANNEL (WhatsApp Cloud API, Facebook Messenger & Instagram Direct)
# ------------------------------------------------------------------------------
# Obtain from: https://developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_PERMANENT_ACCESS_TOKEN=your_meta_permanent_access_token_here
META_VERIFY_TOKEN=your_meta_verify_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_MEETING_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_TEST_NUMBER=+1555188-3377
META_PAGE_ID=your_meta_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# ------------------------------------------------------------------------------
# 10. TELEGRAM BOT (BotFather)
# ------------------------------------------------------------------------------
# Get token by messaging @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 11. TWITTER / X DEVELOPER PORTAL (Direct Messages & Account Activity API)
# ------------------------------------------------------------------------------
# Obtain from: https://developer.x.com
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ------------------------------------------------------------------------------
# 12. LINKEDIN MESSAGING (Developer Portal)
# ------------------------------------------------------------------------------
# Obtain from: https://developer.linkedin.com
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# ------------------------------------------------------------------------------
# 13. TIKTOK BUSINESS MESSAGING (TikTok for Developers)
# ------------------------------------------------------------------------------
# Obtain from: https://business-api.tiktok.com/portal
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# ------------------------------------------------------------------------------
# 14. META THREADS API (Threads for Developers)
# ------------------------------------------------------------------------------
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_VERIFY_TOKEN=your_threads_verify_token_here

# ------------------------------------------------------------------------------
# 15. REDDIT DEVELOPER API (Script & Bot Application)
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_USER_AGENT=OmniReceptionistBot/1.0.0 by /u/your_reddit_username

# ------------------------------------------------------------------------------
# 16. VECTOR MEMORY & OBSERVABILITY (Qdrant & Langfuse)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY="pk-lf-your_langfuse_public_key_here"
LANGFUSE_SECRET_KEY="sk-lf-your_langfuse_secret_key_here"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=https://your-cluster-id.us-central1-0.gcp.cloud.qdrant.io

# ------------------------------------------------------------------------------
# 17. OMNICHANNEL WEBHOOK & OAUTH CALLBACK URIS
# ------------------------------------------------------------------------------
META_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/facebook/callback
WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp
MESSENGER_WEBHOOK_URL=https://your-domain.com/webhook/messenger
INSTAGRAM_WEBHOOK_URL=https://your-domain.com/webhook/instagram
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
LINKEDIN_WEBHOOK_URL=https://your-domain.com/webhook/linkedin
LINKEDIN_REDIRECT_URI=https://your-domain.com/api/oauth/linkedin/callback
TWITTER_WEBHOOK_URL=https://your-domain.com/webhook/twitter
TIKTOK_WEBHOOK_URL=https://your-domain.com/webhook/tiktok
THREADS_WEBHOOK_URL=https://your-domain.com/webhook/threads
REDDIT_WEBHOOK_URL=https://your-domain.com/webhook/reddit

# ------------------------------------------------------------------------------
# 18. CLERK USER AUTHENTICATION
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ------------------------------------------------------------------------------
# 19. TELNYX TELEPHONY & MESSAGING API
# ------------------------------------------------------------------------------
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_API_KEY=your_telnyx_public_api_key_here
TELNYX_PHONE_NUMBER=+16172718180

# ------------------------------------------------------------------------------
# 20. EMAIL NOTIFICATION & CALENDAR DISPATCH (Resend & SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_FROM="Luxe Salon & Spa <onboarding@resend.dev>"
# Optional SMTP fallback:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ------------------------------------------------------------------------------
# 21. SLACK ESCALATION & WORKSPACE NOTIFICATIONS
# ------------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here
SLACK_USER_TOKEN=xoxp-your_slack_user_token_here
SLACK_APP_TOKEN=xapp-your_slack_app_token_here
SLACK_TEAM_ID=your_slack_team_id_here
SLACK_BOT_USER_ID=your_slack_bot_user_id_here
SLACK_ESCALATION_CHANNEL=#manager-escalations
SLACK_ESCALATION_USER_ID=your_slack_escalation_user_id

# ------------------------------------------------------------------------------
# 22. N8N AUTOMATION ENGINE WEBHOOKS
# ------------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_POST_CALL_WEBHOOK_URL=http://localhost:5678/webhook/vapi-end-of-call
N8N_MID_CALL_TOOLS_WEBHOOK_URL=http://localhost:5678/webhook/vapi-salon-tools

# KKP Enterprise Shield & Execution License
KKP_ENTERPRISE_LICENSE_KEY=your_enterprise_license_key_here
