# ========================================================
# Luxe Salon AI Voice Receptionist - Environment Variables
# Just fill in your API keys below to take this to production!
# ========================================================

# 1. Telephony & Voice (Vapi)
# Get from: https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_optional_vapi_assistant_id_here

# 2. WhatsApp & SMS Automation (Twilio)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# 3. Google Sheets Real-Time Sync (Optional)
# Paste service account JSON and target sheet ID
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=

# 4. Storage & Ports
PORT=8000
SALON_DB_PATH=salon_bookings.db
SALON_EXCEL_PATH=salon_appointments.xlsx

